# =============================================================================
# Krisna Monorepo Environment Configuration (.env)
# =============================================================================
# Copy this file to .env at the repository root and populate with your credentials.
#
#   cp .env.example .env
#
# =============================================================================

# --- Hugging Face Authentication (REQUIRED for data-forge fetch & models) ---
# Your User Access Token from https://huggingface.co/settings/tokens (Read permissions)
HF_TOKEN=hf_your_huggingface_access_token_here

# Standard alternative fallback recognized by huggingface_hub
HUGGING_FACE_HUB_TOKEN=hf_your_huggingface_access_token_here

# --- Data-Forge Pipeline Configuration ---
# Root storage directory for raw and processed datasets
# Default on Windows: D:\data_krisna (or ./data)
# Default on Linux: /data_krisna
DATA_ROOT=D:\data_krisna

# Optional GitHub token to avoid API rate limits when running `data-forge doctor`
GITHUB_TOKEN=

# GPU device selection for CUDA stages (e.g., 0 or 0,1)
CUDA_VISIBLE_DEVICES=0

# --- Inference & Pipeline Hardware Profile ---
# 0 = MockBackend (safe test mode, no GPU/weights required)
# 1 = Real model backends (Planner, Sketch, Polish, Critic — GPU required)
KRISNA_USE_REAL_BACKENDS=0

# 0 = Standard high-VRAM mode (e.g. RTX A6000 48GB, RTX 3090/4090 24GB)
# 1 = Low-VRAM CPU-offload mode (targets 12-16GB GPUs like RTX 4080/4070)
KRISNA_LOW_VRAM_MODE=0

# --- Target Machine: NVIDIA RTX A6000 (48GB VRAM) + 128GB System RAM + Intel Core i9 ---
# Set VRAM envelope to 48.0 and RAM envelope to 128.0 for full multi-model residency
KRISNA_VRAM_ENVELOPE_GB=48.0
KRISNA_RAM_ENVELOPE_GB=128.0

# Optional custom python binary for the Critic worker subprocess
# Default: ./venv-critic/Scripts/python.exe (Windows) or ./venv-critic/bin/python (POSIX)
# KRISNA_CRITIC_VENV_PYTHON=

# --- Inference Checkpoint & Weights Paths ---
# Leave unset to use default locations under models/
# KRISNA_PLANNER_RAG_CORPUS_DIR=./models/planner_rag_index
# KRISNA_SKETCH_CHECKPOINT=./models/sketch_tier
# KRISNA_POLISH_DEFAULT_LORA_PATH=./models/polish_default_lora
# KRISNA_BLOB_ROOT=krisna_blobs
