{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CritiqueOutput",
  "type": "object",
  "required": [
    "overall_score",
    "visual_hierarchy_score", "visual_hierarchy_note",
    "readability_score", "readability_note",
    "layout_consistency_score", "layout_consistency_note",
    "brand_alignment_score", "brand_alignment_note"
  ],
  "properties": {
    "overall_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "visual_hierarchy_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "visual_hierarchy_note": {"type": "string", "maxLength": 400},
    "readability_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "readability_note": {"type": "string", "maxLength": 400},
    "layout_consistency_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "layout_consistency_note": {"type": "string", "maxLength": 400},
    "brand_alignment_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "brand_alignment_note": {"type": "string", "maxLength": 400},
    "suggested_edits": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    }
  }
}
