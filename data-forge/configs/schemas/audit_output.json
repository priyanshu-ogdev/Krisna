{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditOutput",
  "type": "object",
  "required": ["caption_matches_image", "structure_matches_image", "overall_pass", "confidence", "rationale"],
  "properties": {
    "caption_matches_image": { "type": "boolean" },
    "structure_matches_image": { "type": "boolean" },
    "quality_issues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safety_issues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "accuracy_issues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hallucination_issues": {
      "type": "array",
      "items": { "type": "string" }
    },
    "overall_pass": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "rationale": { "type": "string", "minLength": 10 }
  },
  "additionalProperties": false
}
