{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SafetyOutput",
  "type": "object",
  "required": ["tier", "confidence", "rationale", "flags"],
  "properties": {
    "tier": { "type": "string", "enum": ["safe", "borderline", "unsafe"] },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "rationale": { "type": "string", "minLength": 10 },
    "flags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
